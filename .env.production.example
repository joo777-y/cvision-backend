NODE_ENV=production
PORT=5000

# MongoDB Configuration - استخدم MongoDB URI الخاص بالإنتاج
MONGODB_URI=mongodb://username:password@host:27017/cv-filtering?authSource=admin

# JWT Configuration - استخدم secrets قوية ومختلفة
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_SECRET_KEY
JWT_EXPIRE=15m

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# CORS Configuration - حدد الدومين الخاص بالـ frontend
CORS_ORIGIN=https://your-frontend-domain.com
